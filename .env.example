# Used by docker-compose.yml. Copy to .env before running `docker compose up`.
# For plain (non-Docker) development, use backend/.env.example and
# frontend/.env.example instead - this file is compose-specific.

CORS_ORIGIN=http://localhost:3000
SQL_SERVER_DATABASE=UniversalMyWFM
# SQL Server requires a strong password (8+ chars, 3 of: upper/lower/digit/symbol).
SQL_SERVER_PASSWORD=Change-Me-1234!

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_PEPPER=change-me-to-a-different-long-random-string
