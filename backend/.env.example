# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# CORS - the frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# SQL Server connection
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=UniversalMyWFM
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=change-me
SQL_SERVER_ENCRYPT=true
SQL_SERVER_TRUST_SERVER_CERTIFICATE=true

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_PEPPER=change-me-to-a-different-long-random-string
